{
  "manifest_version": 3,
  "name": "Velora – liaison Ventiléa",
  "version": "0.1.0",
  "description": "Permet à Velora de lire Ventiléa avec la session ouverte dans ce Chrome. N'agit que sur prescripteurs.ventilea.fr, uniquement à la demande de Velora.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://prescripteurs.ventilea.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}